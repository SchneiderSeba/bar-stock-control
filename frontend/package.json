{
  "name": "barstock-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-runonweb.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test:ocr": "node --experimental-strip-types tests/invoiceOcr.test.mjs",
